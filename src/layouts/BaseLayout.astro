---
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { alternatePath, dir, getLangFromUrl, languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /**
   * Path of this page in the other language. Defaults to the mirrored path;
   * pass `false` for pages that exist in one language only (courses).
   */
  alternate?: string | false;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('site.description'), alternate } = Astro.props;

const otherLang: Lang = lang === 'he' ? 'en' : 'he';
const altHref = alternate === false ? undefined : (alternate ?? alternatePath(Astro.url, otherLang));
const pageTitle = title ? `${title} | ${t('site.name')}` : t('site.name');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} dir={dir[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved light/dark choice before the first paint (no flash).
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altHref && <link rel="alternate" hreflang={otherLang} href={new URL(altHref, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />
    <meta name="theme-color" content="#f3f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1420" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>
    <Header lang={lang} altHref={altHref} altLang={otherLang} altLabel={languages[otherLang]} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
