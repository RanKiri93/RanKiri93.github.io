---
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  altLang: Lang;
  altLabel: string;
  /** Same page in the other language; falls back to that language's home. */
  altHref?: string;
}

const { lang, altLang, altLabel, altHref } = Astro.props;
const t = useTranslations(lang);

// Courses are written in Hebrew only, so every language links to them.
const links: { href: string; label: string; hreflang?: Lang }[] = [
  { href: localePath('he', 'courses/'), label: t('nav.courses'), hreflang: lang === 'he' ? undefined : 'he' },
  { href: localePath(lang, 'research/'), label: t('nav.research') },
  { href: localePath(lang, 'about/'), label: t('nav.about') },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(lang)}>{t('site.name')}</a>
    <nav aria-label={t('nav.label')}>
      <ul>
        {
          links.map(({ href, label, hreflang }) => (
            <li>
              <a href={href} hreflang={hreflang} aria-current={current.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="lang" href={altHref ?? localePath(altLang)} hreflang={altLang} lang={altLang}>
      <span class="visually-hidden">{t('lang.switch')}</span>
      <span aria-hidden="true">{altLabel}</span>
    </a>
    <button type="button" class="theme" aria-pressed="false" title={t('theme.dark')} data-theme-toggle>
      <span class="visually-hidden">{t('theme.dark')}</span>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Light/dark switch. Follows the system until clicked, then remembers the choice.
  const dark = window.matchMedia('(prefers-color-scheme: dark)');
  const root = document.documentElement;
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : dark.matches);

  function sync() {
    const on = isDark();
    for (const button of document.querySelectorAll('[data-theme-toggle]')) button.setAttribute('aria-pressed', String(on));
    // Match the browser UI (address bar on phones) to the chosen theme.
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.content = on ? '#0f1420' : '#f3f5f8';
    }
  }

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Not remembered (private mode or storage blocked); the switch still works for this page.
      }
      sync();
    });
  }
  dark.addEventListener('change', sync);
  sync();
</script>

<style>
  .site-header {
    border-block-end: 1px solid var(--color-rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--color-text);
    text-decoration: none;
    margin-inline-end: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .lang {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'],
  .lang:hover {
    color: var(--color-primary);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-inline-start: calc(-1 * var(--space-2));
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--color-primary);
    background: var(--color-surface);
  }

  .theme svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Show the mode you'd switch to: a moon in light mode, a sun in dark mode.
     Driven by the same rules as the colours, so it's right from the first paint. */
  .theme .sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .theme .moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .theme .sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .theme .moon {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
