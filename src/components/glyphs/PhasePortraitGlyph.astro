---
/**
 * 104136, ODE: phase portrait of the damped oscillator x'' + 0.35x' + x = 0,
 * i.e. (x, y)' = (y, −x − 0.35y). Trajectories spiral into the stable focus
 * at the origin (amber) over the direction field.
 */
import GlyphFrame, { type GlyphProps } from './GlyphFrame.astro';
import { directionField, equalFrame, grid, toPath, type Pt } from './geom';

type Props = GlyphProps;

const DAMPING = 0.35;
const f = ([x, y]: Pt): Pt => [y, -x - DAMPING * y];
const frame = equalFrame(24);

function trajectory(start: Pt): string {
  const dt = 0.03;
  let p: Pt = start;
  const points: Pt[] = [];
  for (let step = 0; step < 1400 && Math.hypot(p[0], p[1]) > 0.06; step++) {
    if (step % 4 === 0) points.push([frame.x(p[0]), frame.y(p[1])]);
    // Runge–Kutta 4
    const k1 = f(p);
    const k2 = f([p[0] + (dt / 2) * k1[0], p[1] + (dt / 2) * k1[1]]);
    const k3 = f([p[0] + (dt / 2) * k2[0], p[1] + (dt / 2) * k2[1]]);
    const k4 = f([p[0] + dt * k3[0], p[1] + dt * k3[1]]);
    p = [p[0] + (dt / 6) * (k1[0] + 2 * k2[0] + 2 * k3[0] + k4[0]), p[1] + (dt / 6) * (k1[1] + 2 * k2[1] + 2 * k3[1] + k4[1])];
  }
  points.push([frame.x(0), frame.y(0)]);
  return toPath(points);
}

const starts: Pt[] = [0, 1, 2, 3, 4].map((i) => {
  // Energy x² + y² only decreases, so starting inside radius 3 keeps every orbit in frame.
  const angle = ((20 + i * 72) * Math.PI) / 180;
  const radius = 2.95 - i * 0.12;
  return [radius * Math.cos(angle), radius * Math.sin(angle)];
});
const trajectories = starts.map((start, i) => ({ d: trajectory(start), t: 150 + i * 140 }));

const field = directionField(
  grid(-4.5, 4.5, -2.7, 2.7, 0.9).map(([x, y]): Pt => [frame.x(x), frame.y(y)]),
  ([sx, sy]) => {
    const [dx, dy] = f([(sx - 120) / 24, (75 - sy) / 24]);
    return [dx, -dy];
  },
  9,
);
---

<GlyphFrame {...Astro.props} label="דיוקן פאזה של מתנד מרוסן: מסלולים מתכנסים בספירלה לנקודת שיווי משקל">
  <path class="field fade" d={field} style="--t: 0"></path>
  {
    trajectories.map(({ d, t }, i) => (
      <path class={i === 0 ? 'main draw' : 'soft draw'} d={d} pathLength="1" style={`--t: ${t}; --dur: 1500ms`} />
    ))
  }
  <circle class="accent pop" cx={frame.x(0)} cy={frame.y(0)} r="3.2" style="--t: 1500"></circle>
</GlyphFrame>
