---
/**
 * The home page picture: the numerical range W(A) of a 4 × 4 matrix, drawn as
 * the envelope of its support lines, with the eigenvalues of A in amber. One
 * support line keeps turning around the boundary; pointing at the picture
 * turns it towards the pointer.
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';
import { numericalRange, type Complex, type Matrix } from '../lib/numericalRange';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Upper triangular, so the eigenvalues are the diagonal; the entries above it
// make A far from normal, and W(A) much rounder than the hull of its spectrum.
const eigenvalues: Complex[] = [
  [-1.3, 0.6],
  [1.2, 1.0],
  [0.9, -1.1],
  [-0.2, -0.1],
];
const A: Matrix = [
  [eigenvalues[0], [0.9, 0], [0, 0.4], [-0.5, 0]],
  [[0, 0], eigenvalues[1], [0.7, -0.3], [0, 0.6]],
  [[0, 0], [0, 0], eigenvalues[2], [1.0, 0]],
  [[0, 0], [0, 0], [0, 0], eigenvalues[3]],
];

const SIZE = 400;
const MARGIN = 64;
const SAMPLES = 360;
/** Must divide SAMPLES. */
const LINES = 36;

const boundary = numericalRange(A, SAMPLES);
const xs = boundary.map(({ point }) => point[0]);
const ys = boundary.map(({ point }) => point[1]);
const [minX, maxX, minY, maxY] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
const scale = (SIZE - 2 * MARGIN) / Math.max(maxX - minX, maxY - minY);
const midX = (minX + maxX) / 2;
const midY = (minY + maxY) / 2;

const r = (n: number) => Math.round(n * 10) / 10;
const sx = (x: number) => r(SIZE / 2 + (x - midX) * scale);
const sy = (y: number) => r(SIZE / 2 - (y - midY) * scale);
const at = ([x, y]: Complex): [number, number] => [sx(x), sy(y)];

const outline = `M${boundary.map(({ point }) => at(point).join(' ')).join('L')}Z`;

// A support line with outer normal e^{iθ} runs along i·e^{iθ}; on screen y points down.
const REACH = SIZE;
const supportLine = (theta: number, [x, y]: [number, number]) => {
  const dx = -Math.sin(theta) * REACH;
  const dy = -Math.cos(theta) * REACH;
  return { x, y, x1: r(x + dx), y1: r(y + dy), x2: r(x - dx), y2: r(y - dy) };
};

const lines = Array.from({ length: LINES }, (_, i) => {
  const { theta, point } = boundary[(i * SAMPLES) / LINES];
  return supportLine(theta, at(point));
});

// The hull of the spectrum, to compare with W(A): drop the eigenvalue inside.
const hull = `M${eigenvalues
  .slice(0, 3)
  .map((z) => at(z).join(' '))
  .join('L')}Z`;

const origin = at([0, 0]);
const points = boundary.map(({ point }) => at(point));
const start = Math.round(SAMPLES * 0.15);
const first = supportLine(boundary[start].theta, points[start]);

const tex = (source: string) => katex.renderToString(source, { throwOnError: false });
const caption = t('home.figureCaption').replace('{W}', tex(String.raw`W(A) = \{\langle Ax, x\rangle : \|x\| = 1\}`));
---

<figure class="numrange">
  <svg
    viewBox={`0 0 ${SIZE} ${SIZE}`}
    role="img"
    aria-label={t('home.figureLabel')}
    data-numrange
    data-points={JSON.stringify(points)}
    data-start={start}
  >
    <defs>
      <radialGradient id="numrange-fade">
        <stop offset="0.35" stop-color="#fff"></stop>
        <stop offset="1" stop-color="#000"></stop>
      </radialGradient>
      <mask id="numrange-mask">
        <rect width={SIZE} height={SIZE} fill="url(#numrange-fade)"></rect>
      </mask>
    </defs>

    <g class="axes">
      <line x1="0" x2={SIZE} y1={origin[1]} y2={origin[1]}></line>
      <line x1={origin[0]} x2={origin[0]} y1="0" y2={SIZE}></line>
    </g>

    <g class="supports" mask="url(#numrange-mask)">
      {
        lines.map(({ x, y, x1, y1, x2, y2 }, i) => (
          <g style={`--i: ${i}`}>
            <line x1={x} y1={y} x2={x1} y2={y1} pathLength="1" />
            <line x1={x} y1={y} x2={x2} y2={y2} pathLength="1" />
          </g>
        ))
      }
    </g>

    <path class="region" d={outline}></path>
    <path class="hull" d={hull}></path>
    <path class="boundary" d={outline} pathLength="1"></path>

    <g class="spectrum">
      {
        eigenvalues.map((z, i) => {
          const [cx, cy] = at(z);
          return <circle cx={cx} cy={cy} r="5" style={`--i: ${i}`} />;
        })
      }
    </g>

    <g class="live" mask="url(#numrange-mask)">
      <line x1={first.x1} y1={first.y1} x2={first.x2} y2={first.y2} data-live-line></line>
    </g>
    <circle class="touch" cx={first.x} cy={first.y} r="4.5" data-live-point></circle>
  </svg>
  <figcaption set:html={caption} />
</figure>

<script>
  type Pt = [number, number];

  for (const svg of document.querySelectorAll<SVGSVGElement>('[data-numrange]')) {
    const points: Pt[] = JSON.parse(svg.dataset.points ?? '[]');
    const line = svg.querySelector<SVGLineElement>('[data-live-line]');
    const dot = svg.querySelector<SVGCircleElement>('[data-live-point]');
    if (!points.length || !line || !dot) continue;

    const n = points.length;
    const reach = svg.viewBox.baseVal.width;
    const centre = points.reduce<Pt>(([a, b], [x, y]) => [a + x / n, b + y / n], [0, 0]);
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    // Position along the boundary, in samples (one sample per degree of normal direction).
    let position = Number(svg.dataset.start ?? 0);
    let target: number | null = null;
    let visible = true;
    let last = performance.now();

    const draw = () => {
      const i = Math.floor(position);
      const f = position - i;
      const [ax, ay] = points[((i % n) + n) % n];
      const [bx, by] = points[(((i + 1) % n) + n) % n];
      const x = ax + (bx - ax) * f;
      const y = ay + (by - ay) * f;
      const theta = (2 * Math.PI * position) / n;
      const dx = -Math.sin(theta) * reach;
      const dy = -Math.cos(theta) * reach;
      line.setAttribute('x1', String(x + dx));
      line.setAttribute('y1', String(y + dy));
      line.setAttribute('x2', String(x - dx));
      line.setAttribute('y2', String(y - dy));
      dot.setAttribute('cx', String(x));
      dot.setAttribute('cy', String(y));
    };

    const tick = (now: number) => {
      const dt = Math.min(now - last, 100);
      last = now;
      if (target !== null) {
        // Ease towards the pointer along the shorter way round.
        const gap = ((((target - position) % n) + n * 1.5) % n) - n / 2;
        position += gap * Math.min(1, dt / 160);
      } else if (!still.matches) {
        position += dt * 0.012;
      }
      position = ((position % n) + n) % n;
      draw();
      if (visible) requestAnimationFrame(tick);
    };

    svg.addEventListener('pointermove', (event) => {
      const box = svg.getBoundingClientRect();
      const x = ((event.clientX - box.left) / box.width) * reach - centre[0];
      const y = ((event.clientY - box.top) / box.height) * reach - centre[1];
      // The support line whose normal points at the pointer.
      target = ((Math.atan2(-y, x) / (2 * Math.PI)) * n + n) % n;
    });
    svg.addEventListener('pointerleave', () => (target = null));

    new IntersectionObserver(([entry]) => {
      const wasVisible = visible;
      visible = entry.isIntersecting;
      if (visible && !wasVisible) {
        last = performance.now();
        requestAnimationFrame(tick);
      }
    }).observe(svg);

    requestAnimationFrame(tick);
  }
</script>

<style>
  .numrange {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
  }

  .axes line {
    stroke: var(--color-rule);
    stroke-width: 1;
  }

  .supports line {
    stroke: var(--color-primary);
    stroke-width: 0.8;
    opacity: 0.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 900ms cubic-bezier(0.3, 0.7, 0.2, 1) forwards;
    animation-delay: calc(200ms + var(--i) * 35ms);
  }

  .region {
    fill: var(--color-primary);
    opacity: 0;
    animation: fade-to 900ms ease forwards 1300ms;
    --to: 0.08;
  }

  .hull {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0;
    animation: fade-to 600ms ease forwards 2300ms;
    --to: 0.7;
  }

  .boundary {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 2.25;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1400ms cubic-bezier(0.5, 0, 0.2, 1) forwards 1100ms;
  }

  .spectrum circle {
    fill: var(--color-accent);
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 420ms cubic-bezier(0.2, 0.8, 0.3, 1.4) both;
    animation-delay: calc(2000ms + var(--i) * 110ms);
  }

  .live line {
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .live,
  .touch {
    opacity: 0;
    animation: fade-to 500ms ease forwards 2700ms;
    --to: 1;
  }

  .touch {
    fill: var(--color-surface);
    stroke: var(--color-text);
    stroke-width: 1.5;
  }

  figcaption {
    margin-block-start: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-to {
    to {
      opacity: var(--to);
    }
  }

  @keyframes pop {
    from {
      scale: 0;
    }
  }

  /* No build-up: show the finished picture straight away. */
  @media (prefers-reduced-motion: reduce) {
    .supports line,
    .boundary,
    .region,
    .hull,
    .spectrum circle,
    .live,
    .touch {
      animation: none;
    }

    .supports line,
    .boundary {
      stroke-dashoffset: 0;
    }

    .region,
    .hull,
    .live,
    .touch {
      opacity: var(--to);
    }
  }
</style>
