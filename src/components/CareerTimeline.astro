---
/**
 * Studies, teaching roles and teaching awards on one time axis. Time runs in
 * the reading direction (right to left in Hebrew). Ongoing spans fade out at
 * their open end. Purely visual; the lists on the About page carry the content.
 */
import { awards, timeline, type Span } from '../data/profile';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const now = new Date();
const NOW = now.getFullYear() + now.getMonth() / 12;
const START = 2016;
const END = Math.ceil(NOW + 0.25);
const SPAN = END - START;

const pos = (year: number) => `${(((year - START) / SPAN) * 100).toFixed(2)}%`;
const band = ({ from, to }: Span) =>
  `inset-inline-start: ${pos(from)}; width: ${((((to ?? NOW) - from) / SPAN) * 100).toFixed(2)}%; --delay: ${Math.round((from - START) * 110)}ms`;

const years = Array.from({ length: Math.floor(SPAN / 2) + 1 }, (_, i) => START + 2 * i).filter((y) => y <= END);

const rows = [
  { label: t('about.studies'), tracks: [timeline.studies], kind: 'study' },
  { label: t('about.teaching'), tracks: timeline.teaching, kind: 'teach' },
] as const;
---

<figure class="career" aria-hidden="true">
  {
    rows.map((row) => (
      <div class="row">
        <span class="row-label">{row.label}</span>
        <div class="tracks">
          {row.tracks.map((track) => (
            <div class="track">
              {track.map((span) => (
                <span
                  class:list={['band', row.kind, { ongoing: span.to === null, short: (span.to ?? NOW) - span.from < 1.5 }]}
                  style={band(span)}
                >
                  <span class="band-label">{span.label[lang]}</span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))
  }
  <div class="row">
    <span class="row-label">{t('about.awardsShort')}</span>
    <div class="tracks">
      <div class="track">
        {
          timeline.awardSpans.map((span) => (
            <span class="band award" style={band(span)}>
              <span class="band-label">{span.label[lang]}</span>
            </span>
          ))
        }
      </div>
      <div class="track marks">
        {
          timeline.awardMarks.map(({ at, award }) => (
            <span
              class:list={['mark', awards[award].shape]}
              style={`inset-inline-start: ${pos(at)}; --delay: ${Math.round((at - START) * 110)}ms`}
            />
          ))
        }
      </div>
    </div>
  </div>
  <div class="row axis-row">
    <span class="row-label"></span>
    <div class="axis">
      {years.map((year) => <span style={`inset-inline-start: ${pos(year)}`}>{year}</span>)}
      <span class="now" style={`inset-inline-start: ${pos(NOW)}`}></span>
    </div>
  </div>
</figure>

<style>
  .career {
    margin: var(--space-4) 0;
    display: grid;
    gap: var(--space-2);
  }

  .row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
  }

  .row-label {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .tracks {
    display: grid;
    gap: 0.35rem;
  }

  .track {
    position: relative;
    height: 1.9rem;
  }

  .track.marks {
    height: 1rem;
  }

  .band {
    position: absolute;
    inset-block: 0;
    display: flex;
    align-items: center;
    padding-inline: var(--space-2);
    border-radius: 4px;
    overflow: hidden;
    transform-origin: left center;
    animation: grow-band 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: var(--delay);
  }

  :global([dir='rtl']) .band {
    transform-origin: right center;
  }

  .band-label {
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Too short for its name: the label sits just before the band instead. */
  .band.short {
    overflow: visible;
  }

  .band.short .band-label {
    position: absolute;
    inset-inline-end: calc(100% + 0.4rem);
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .study {
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
    color: var(--color-text);
  }

  .teach {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .award {
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
    color: var(--color-text);
  }

  /* Still going: the band fades out at its open end. */
  .ongoing {
    mask-image: linear-gradient(to right, #000 75%, transparent);
  }

  :global([dir='rtl']) .ongoing {
    mask-image: linear-gradient(to left, #000 75%, transparent);
  }

  .mark {
    position: absolute;
    inset-block-start: 50%;
    width: 0.7rem;
    height: 0.7rem;
    margin-inline-start: -0.35rem;
    translate: 0 -50%;
    background: var(--color-accent);
    animation: pop-mark 380ms cubic-bezier(0.2, 0.8, 0.3, 1.3) both;
    animation-delay: calc(var(--delay) + 300ms);
  }

  .mark.dot {
    border-radius: 50%;
  }

  .mark.diamond {
    rotate: 45deg;
    width: 0.6rem;
    height: 0.6rem;
  }

  .axis {
    position: relative;
    height: 1.4rem;
    border-block-start: 1px solid var(--color-rule);
  }

  .axis span {
    position: absolute;
    inset-block-start: 0.2rem;
    translate: -50% 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  :global([dir='rtl']) .axis span {
    translate: 50% 0;
  }

  .axis .now {
    inset-block-start: -0.35rem;
    width: 2px;
    height: 0.7rem;
    background: var(--color-text);
    translate: 0 0;
  }

  @keyframes grow-band {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes pop-mark {
    from {
      scale: 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band,
    .mark {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }

    .row-label:empty {
      display: none;
    }

    /* Award bands are too narrow here for a name; the legend below keys them. */
    .award .band-label {
      display: none;
    }
  }
</style>
